{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "doca-admin",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-19",
  "observability": { "enabled": true },

  // run_worker_first is essential: without it Cloudflare serves a matching static asset
  // BEFORE invoking the script, so the admin UI would bypass the Access check entirely
  // and be served to anyone. Verified: it was.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "doca-content",
      "database_id": "04dc6c71-051c-4af9-8daa-79374d565c5e"
    }
  ],

  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "doca-media" }],

  // Contact form email. Locked to ONE verified recipient and ONE sender, so the public
  // /api/contact endpoint can never be used to mail anyone else. Sending to a verified
  // destination is free on the Workers Free plan; arbitrary recipients would need Paid.
  // Requires Email Routing on docastudio.ro and office@doca-ad.ro verified as a destination.
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "office@doca-ad.ro",
      "allowed_sender_addresses": ["noreply@docastudio.ro"]
    }
  ],

  "vars": {
    // Cloudflare Access team domain, used to verify the signed JWT.
    "ACCESS_TEAM_DOMAIN": "rapid-fog-f675.cloudflareaccess.com",
    "CONTACT_TO": "office@doca-ad.ro",
    "CONTACT_FROM": "noreply@docastudio.ro"
  }
}
