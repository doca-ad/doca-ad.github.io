---
import Base from "@/layouts/Base.astro";
import Navigation from "@/components/Navigation";
import { Image } from "astro:assets";
import founders from "@/assets/founders.jpg";
import { META, t, type Locale } from "@/i18n/ui";
import { ABOUT } from "@/i18n/about";

interface Props { locale: Locale }
const { locale } = Astro.props;
const meta = META["/info"][locale];
const a = ABOUT[locale];
---

<Base title={meta.title} description={meta.description} breadcrumb={meta.title}>
  <div class="min-h-screen bg-background">
    <Navigation locale={locale} routeKey="/info" client:load />

    <main class="pt-32 pb-16">
      <div class="max-w-4xl mx-auto px-8">
        <h1 class="text-4xl md:text-5xl font-light text-text-primary text-center mb-12">
          {t(locale, "info.title")}
        </h1>

        <figure class="mb-16 max-w-2xl mx-auto">
          <Image
            src={founders}
            alt={locale === "ro"
              ? "Vlad Căpitanu și Ștefan Diaconescu, fondatorii DOCA Arhitectură & Design"
              : "Vlad Căpitanu and Ștefan Diaconescu, founders of DOCA Architecture & Design"}
            widths={[480, 768, 1024]}
            sizes="(max-width: 768px) 100vw, 672px"
            format="avif"
            class="w-full h-auto"
          />
          <figcaption class="mt-3 text-center text-sm text-text-tertiary">
            {t(locale, "info.founders")}
          </figcaption>
        </figure>

        <div class="max-w-3xl mx-auto space-y-8">
          <p class="text-lg text-text-secondary leading-relaxed text-justify">
            {a.intro.before}
            <a href="https://www.linkedin.com/in/stefandiaconescu" target="_blank" rel="noopener noreferrer"
               class="font-medium text-text-primary hover:text-accent-hover transition-colors duration-200">Ștefan Diaconescu</a>
            {a.intro.and}
            <a href="https://www.linkedin.com/in/vlad-capitanu-12850b1ab" target="_blank" rel="noopener noreferrer"
               class="font-medium text-text-primary hover:text-accent-hover transition-colors duration-200">Vlad Căpitanu</a>{a.intro.after}
          </p>

          {a.paragraphs.map((para) => (
            <p class="text-lg text-text-secondary leading-relaxed text-justify">{para}</p>
          ))}

          <section class="text-lg text-text-secondary leading-relaxed text-justify">
            <h2 class="font-semibold mb-4 text-text-primary">{t(locale, "info.paths")}</h2>
            <ul class="space-y-4">
              {a.paths.map((p) => (
                <li><span class="font-medium">{p.name}</span>{p.text}</li>
              ))}
            </ul>
          </section>

          <p class="text-lg text-text-secondary leading-relaxed text-justify">{a.closing}</p>
        </div>
      </div>
    </main>
  </div>
</Base>
