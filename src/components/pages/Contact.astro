---
import Base from "@/layouts/Base.astro";
import Navigation from "@/components/Navigation";
import { META, t, type Locale } from "@/i18n/ui";

interface Props { locale: Locale }
const { locale } = Astro.props;
const meta = META["/contact"][locale];
---

<Base title={meta.title} description={meta.description} breadcrumb={meta.title}>
  <div class="min-h-screen bg-background">
    <Navigation locale={locale} routeKey="/contact" client:load />

    <main class="min-h-screen flex flex-col">
      <div class="max-w-4xl mx-auto px-4 md:px-8 pt-32 pb-8">
        <h1 class="text-4xl md:text-5xl font-light text-text-primary text-center mb-8 md:mb-16">
          {t(locale, "contact.title")}
        </h1>
      </div>

      <div class="max-w-4xl mx-auto px-4 md:px-8 flex-1 flex flex-col justify-center md:-mt-32">
        <div class="text-center mb-12 md:mb-16">
          <p class="text-base md:text-lg text-text-secondary max-w-2xl mx-auto leading-relaxed mb-4">
            {t(locale, "contact.invitation")}
          </p>
          <p class="text-base md:text-lg text-text-secondary max-w-2xl mx-auto leading-relaxed">
            {t(locale, "contact.social")}{" "}
            <a href="https://www.instagram.com/doca_architecture/" target="_blank" rel="noopener noreferrer"
               class="text-accent-primary hover:text-accent-hover transition-colors duration-200">Instagram</a>
            {t(locale, "contact.and")}
            <a href="https://www.linkedin.com/company/doca-architecture-design/" target="_blank" rel="noopener noreferrer"
               class="text-accent-primary hover:text-accent-hover transition-colors duration-200">LinkedIn</a>
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-8 md:gap-12 text-center">
          <div class="flex flex-col items-center">
            <h2 class="text-lg font-medium text-text-primary mb-2">{t(locale, "contact.email")}</h2>
            <a href="mailto:office@doca-ad.ro"
               class="text-text-secondary hover:text-accent-hover transition-colors duration-200">office@doca-ad.ro</a>
          </div>

          <div class="flex flex-col items-center">
            <h2 class="text-lg font-medium text-text-primary mb-2">{t(locale, "contact.phone")}</h2>
            <a href="tel:+40760972231"
               class="text-text-secondary hover:text-accent-hover transition-colors duration-200">+40 760 972 231</a>
            <a href="tel:+40723340088"
               class="text-text-secondary hover:text-accent-hover transition-colors duration-200">+40 723 340 088</a>
          </div>

          <div class="flex flex-col items-center">
            <h2 class="text-lg font-medium text-text-primary mb-2">{t(locale, "contact.studio")}</h2>
            <a href="https://maps.app.goo.gl/LfxqPwfFMFvS81bP6" target="_blank" rel="noopener noreferrer"
               class="text-text-secondary hover:text-accent-hover transition-colors duration-200">
              {locale === "ro" ? "București, România" : "Bucharest, Romania"}
            </a>
          </div>
        </div>
      </div>
    </main>
  </div>
</Base>
