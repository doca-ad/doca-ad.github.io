---
import Base from "@/layouts/Base.astro";
import Navigation from "@/components/Navigation";
import ProjectsList from "@/components/ProjectsList";
import { loadProjects } from "@/lib/content";
import { resolveProjects } from "@/lib/images";
import { localizeProject } from "@/lib/localize";
import { PROJECT_DESCRIPTIONS_RO } from "@/data/translations.ro";
import { META, t, type Locale } from "@/i18n/ui";

interface Props { locale: Locale }
const { locale } = Astro.props;

const resolved = await resolveProjects(
  [...(await loadProjects())].sort((a, b) => Number(b.year) - Number(a.year))
);
// Flatten each project to one language once, here, so the island stays language-agnostic.
const localised = resolved.map((p) => localizeProject(p, locale, PROJECT_DESCRIPTIONS_RO[p.id]));
const meta = META["/projects"][locale];
---

<Base title={meta.title} description={meta.description} breadcrumb={meta.title}>
  <div class="min-h-screen bg-background">
    <Navigation locale={locale} routeKey="/projects" client:load />
    <main class="pt-32 pb-16">
      <div class="max-w-7xl mx-auto px-8">
        <h1 class="text-4xl md:text-5xl font-light text-text-primary text-center mb-16">
          {t(locale, "projects.title")}
        </h1>
        <ProjectsList projects={localised} client:load />
      </div>
    </main>
  </div>
</Base>
