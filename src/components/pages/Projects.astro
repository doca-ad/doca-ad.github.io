---
import Base from "@/layouts/Base.astro";
import Navigation from "@/components/Navigation";
import ProjectsList from "@/components/ProjectsList";
import { loadProjects } from "@/lib/content";
import { resolveProjects, slugify } from "@/lib/images";
import { PROJECT_DESCRIPTIONS_RO } from "@/data/translations.ro";
import { META, t, localePath, type Locale } from "@/i18n/ui";

interface Props { locale: Locale }
const { locale } = Astro.props;

const resolved = await resolveProjects(
  [...(await loadProjects())].sort((a, b) => Number(b.year) - Number(a.year))
);
// Swap in the Romanian description and localise the link target for each row.
const localised = resolved.map((p) => ({
  ...p,
  description: locale === "ro" ? PROJECT_DESCRIPTIONS_RO[p.id] ?? p.description : p.description,
  href: localePath(locale, `/projects/${slugify(p)}`),
}));
const meta = META["/projects"][locale];
---

<Base title={meta.title} description={meta.description} breadcrumb={meta.title}>
  <div class="min-h-screen bg-background">
    <Navigation locale={locale} routeKey="/projects" client:load />
    <main class="pt-32 pb-16">
      <div class="max-w-7xl mx-auto px-8">
        <h1 class="text-4xl md:text-5xl font-light text-text-primary text-center mb-16">
          {t(locale, "projects.title")}
        </h1>
        <ProjectsList projects={localised} locale={locale} client:load />
      </div>
    </main>
  </div>
</Base>
