---
import Base from "@/layouts/Base.astro";
import Navigation from "@/components/Navigation";

const links = [
  { href: "https://www.instagram.com/doca_architecture/", label: "Instagram" },
  { href: "https://www.linkedin.com/company/doca-architecture-design/", label: "LinkedIn" },
];
---

<Base
  title="Contact"
  description="Get in touch with DOCA Architecture & Design in Bucharest — office@doca-ad.ro, +40 723 340 088."
  breadcrumb="Contact"
>
  <div class="min-h-screen bg-background">
    <Navigation client:load />

    <main class="min-h-screen flex flex-col">
      <div class="max-w-4xl mx-auto px-4 md:px-8 pt-32 pb-8">
        <h1 class="text-4xl md:text-5xl font-light text-text-primary text-center mb-8 md:mb-16">
          Contact
        </h1>
      </div>

      <div class="max-w-4xl mx-auto px-4 md:px-8 flex-1 flex flex-col justify-center md:-mt-32">
        <div class="text-center mb-12 md:mb-16">
          <p class="text-base md:text-lg text-text-secondary max-w-2xl mx-auto leading-relaxed mb-4">
            We are always looking forward to meeting passionate people. Don't hesitate to contact us!
          </p>
          <p class="text-base md:text-lg text-text-secondary max-w-2xl mx-auto leading-relaxed">
            You can also find us on social media platforms:{" "}
            {links.map((l, i) => (
              <>
                <a href={l.href} target="_blank" rel="noopener noreferrer"
                   class="text-accent-primary hover:text-accent-hover transition-colors duration-200">{l.label}</a>
                {i === 0 ? " and " : ""}
              </>
            ))}
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-8 md:gap-12 text-center">
          <div class="flex flex-col items-center">
            <h2 class="text-lg font-medium text-text-primary mb-2">Email</h2>
            <a href="mailto:office@doca-ad.ro"
               class="text-text-secondary hover:text-accent-hover transition-colors duration-200">office@doca-ad.ro</a>
          </div>

          <div class="flex flex-col items-center">
            <h2 class="text-lg font-medium text-text-primary mb-2">Phone</h2>
            <a href="tel:+40760972231"
               class="text-text-secondary hover:text-accent-hover transition-colors duration-200">+40 760 972 231</a>
            <a href="tel:+40723340088"
               class="text-text-secondary hover:text-accent-hover transition-colors duration-200">+40 723 340 088</a>
          </div>

          <div class="flex flex-col items-center">
            <h2 class="text-lg font-medium text-text-primary mb-2">Studio</h2>
            <a href="https://maps.app.goo.gl/LfxqPwfFMFvS81bP6" target="_blank" rel="noopener noreferrer"
               class="text-text-secondary hover:text-accent-hover transition-colors duration-200">
              Bucharest, Romania
            </a>
          </div>
        </div>
      </div>
    </main>
  </div>
</Base>
