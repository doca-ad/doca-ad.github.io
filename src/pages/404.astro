---
import Base from "@/layouts/Base.astro";
import Navigation from "@/components/Navigation";
---

<Base title="Page not found" description="The page you are looking for does not exist.">
  <div class="min-h-screen bg-background">
    <Navigation client:load />
    <main class="min-h-screen flex flex-col items-center justify-center px-8 text-center">
      <h1 class="text-4xl md:text-5xl font-light text-text-primary mb-4">Page not found</h1>
      <p class="text-text-secondary mb-8">The page you are looking for does not exist.</p>
      <a href="/" class="text-accent-primary hover:text-accent-hover transition-colors">← Back to home</a>
    </main>
  </div>
</Base>
