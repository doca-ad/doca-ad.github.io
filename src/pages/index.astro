---
import Base from "@/layouts/Base.astro";
import Navigation from "@/components/Navigation";
import ProjectCarousel from "@/components/ProjectCarousel";
import { projects } from "@/data/projects";
import { resolveProjects } from "@/lib/images";

const homeProjects = await resolveProjects(
  projects.filter((p) => p.home).sort((a, b) => (a.homeIndex ?? 0) - (b.homeIndex ?? 0))
);
---

<Base
  title="DOCA Architecture & Design"
  description="Bucharest-based architecture and interior design studio founded in 2024 by Ștefan Diaconescu and Vlad Căpitanu. Space efficiency, usability, urban integration and human-scale architecture."
>
  <div class="min-h-screen bg-background">
    <Navigation client:load />
    <main class="min-h-screen bg-background">
      <div class="h-screen bg-background">
        <ProjectCarousel projects={homeProjects} landing="statement" client:load />
      </div>
    </main>
  </div>
</Base>
