---
import ProjectDetail from "@/components/pages/ProjectDetail.astro";
import { loadProjects } from "@/lib/content";

import { resolveProject, slugify } from "@/lib/images";

/**
 * A real page per project; the SPA had none, leaving Google a single route with no
 * indexable content. Index-only entries are excluded: they have no content to show.
 */
export async function getStaticPaths() {
  // Index-only entries have nothing to show, so they get no page of their own.
  const publishable = (await loadProjects()).filter(
    (p) => !p.index_only && p.images.length > 0
  );
  return Promise.all(
    publishable.map(async (project) => ({
      params: { slug: slugify(project) },
      props: { project: await resolveProject(project) },
    }))
  );
}

const { project } = Astro.props;
---
<ProjectDetail locale="en" project={project} />
